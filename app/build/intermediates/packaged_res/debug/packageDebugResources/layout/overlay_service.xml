<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_filled"
    android:backgroundTint="@color/b"
    android:clickable="true"
    android:elevation="24dp"
    android:focusable="true"
    android:orientation="vertical"
    android:stateListAnimator="@null"
    android:translationZ="12dp">

    <!-- ============================================== -->
    <!-- HEADER STRIP                                   -->
    <!-- ============================================== -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#15FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- App Icon -->
        <LinearLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_filled"
            android:backgroundTint="@color/f"
            android:gravity="center">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/ic_logo"
                android:backgroundTint="@color/b" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/aigd"
            android:letterSpacing="0.02"
            android:text="READER FLOATING"
            android:textColor="@color/f"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Status Indicator -->
        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:alpha="0.6"
            android:background="@drawable/bg_filled"
            android:backgroundTint="@color/f" />

    </RelativeLayout>

    <!-- ============================================== -->
    <!-- SCRIPT DISPLAY AREA                          -->
    <!-- ============================================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Anchor Line (Reading Guide) -->
        <View
            android:id="@+id/anchorLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:alpha="0.8"
            android:background="@color/f"
            android:elevation="4dp" />

        <!-- Scroll View -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/overlayScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="150dp"
                android:paddingBottom="150dp">

                <TextView
                    android:id="@+id/scriptTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/aigd"
                    android:gravity="center"
                    android:lineSpacingExtra="12dp"
                    android:text="Welcome to Reader Floating Teleprompter"
                    android:textColor="@color/f"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </FrameLayout>

    <!-- ============================================== -->
    <!-- SPEED ADJUSTMENT BAR                         -->
    <!-- ============================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#18FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Speed Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:alpha="0.6"
            android:fontFamily="@font/aigd"
            android:text="Speed"
            android:textColor="@color/f"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Minus Button -->
        <LinearLayout
            android:id="@+id/speedMinus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_outline"
            android:backgroundTint="@color/f"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:translationZ="2dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_minus"
                app:tint="@color/b" />
        </LinearLayout>

        <!-- SeekBar -->
        <SeekBar
            android:id="@+id/speedSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="300"
            android:progress="100"
            android:progressTint="@color/f"
            android:thumb="@drawable/seekbar_thumb"
            android:thumbTint="@color/f" />

        <!-- Plus Button -->
        <LinearLayout
            android:id="@+id/speedPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_outline"
            android:backgroundTint="@color/f"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:translationZ="2dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_plus"
                app:tint="@color/b" />
        </LinearLayout>

        <!-- Speed Value -->
        <TextView
            android:id="@+id/speedValueText"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/aigd"
            android:gravity="end"
            android:text="1.00x"
            android:textColor="@color/f"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ============================================== -->
    <!-- CONTROL TOOLBAR                              -->
    <!-- ============================================== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#15FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Close Button -->
        <LinearLayout
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_outline"
            android:backgroundTint="@color/f"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:translationZ="2dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_close"
                app:tint="@color/b" />
        </LinearLayout>

        <!-- Play Button (Center) -->
        <LinearLayout
            android:id="@+id/playButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_filled"
            android:backgroundTint="@color/f"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:translationZ="6dp">

            <ImageView
                android:id="@+id/playIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_play"
                app:tint="@color/b" />
        </LinearLayout>

        <!-- Right Side Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- Drag Handle -->
            <LinearLayout
                android:id="@+id/dragHandle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_outline"
                android:backgroundTint="@color/f"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@null"
                android:translationZ="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_drag"
                    app:tint="@color/b" />
            </LinearLayout>

            <!-- Resize Handle -->
            <LinearLayout
                android:id="@+id/resizeHandle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_outline"
                android:backgroundTint="@color/f"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@null"
                android:translationZ="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_resize"
                    app:tint="@color/b" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <!-- ============================================== -->
    <!-- BOTTOM ACCENT LINE                           -->
    <!-- ============================================== -->
    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.15"
        android:background="@color/f" />

</LinearLayout>