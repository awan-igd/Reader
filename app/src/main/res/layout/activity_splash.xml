<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/b"
    tools:context="SplashActivity">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="150dp"
            android:layout_height="150dp"

            android:backgroundTint="@color/f"
            android:contentDescription="App Icon"
            android:padding="30dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_logo" />

        <!-- App Name -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/aigd"
            android:letterSpacing="0.04"
            android:text="READER"
            android:textColor="@color/f"
            android:textSize="48sp"
            android:textStyle="bold" />

        <!-- Decorative Line -->
        <View
            android:id="@+id/decorativeLine"
            android:layout_width="80dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:background="@color/f" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alpha="0.7"
            android:fontFamily="@font/aigd"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Speak. Record. Dominate."
            android:textColor="@color/f"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <!-- Circular Progress Bar -->
        <ProgressBar
            android:id="@+id/circularProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/f" />


    </LinearLayout>

    <!-- Footer Credit -->
    <TextView
        android:id="@+id/footerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="58dp"
        android:alpha="0.5"
        android:fontFamily="@font/aigd"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:text="Awan IGD"
        android:textColor="@color/f"
        android:textSize="11sp" />

</RelativeLayout>