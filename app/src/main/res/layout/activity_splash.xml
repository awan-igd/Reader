<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/b">

    <View
        android:id="@+id/designCircle"
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="-180dp"
        android:background="@drawable/bg_circal" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="48dp"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/logoCard"
            android:layout_width="130dp"
            android:layout_height="130dp"
            app:cardBackgroundColor="@color/f"
            app:cardCornerRadius="65dp"
            app:cardElevation="16dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="App Logo"
                android:src="@drawable/ic_logo"
               />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/aigd"
            android:letterSpacing="0.12"
            android:text="READER"
            android:textColor="@color/b"
            android:textSize="40sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/decorativeLine"
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:alpha="0.5"
            android:background="@color/b" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.85"
            android:fontFamily="@font/aigd"
            android:text="Speak. Record. Dominate."
            android:textColor="@color/b"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/b" />

    </LinearLayout>

    <TextView
        android:id="@+id/footerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="160dp"
        android:fontFamily="@font/aigd"
        android:letterSpacing="0.1"
        android:text="Awan IGD"
        android:textColor="@color/b"
        android:textSize="12sp" />

</RelativeLayout>