<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#E6000000"
    app:cardCornerRadius="18dp"
    app:cardElevation="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. TOP DRAG - بالکل اوپر پتلا -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#0DFFFFFF"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_filled"
                android:backgroundTint="#66FFFFFF" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_filled"
                android:backgroundTint="@color/t" />
        </LinearLayout>

        <!-- 2. SCRIPT - وزن 1 - اوپر سے نیچے تک پوری جگہ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Anchor Line بیچ میں -->
            <View
                android:id="@+id/anchorLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.3"
                android:background="@color/t" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/overlayScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/scriptTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/aigd"
                    android:gravity="center"
                    android:lineSpacingExtra="14dp"
                    android:paddingStart="18dp"
                    android:paddingTop="160dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="300dp"
                    android:textColor="@color/f"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <!-- 3. SPEED BAR - کنٹرول سے اوپر، باٹم کے قریب -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#16FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/speedMinus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:cardBackgroundColor="#24FFFFFF"
                app:cardCornerRadius="11dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/f" />
            </com.google.android.material.card.MaterialCardView>

            <SeekBar
                android:id="@+id/speedSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:max="50"
                android:progress="10"
                android:progressTint="@color/f"
                android:thumbTint="@color/f" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/speedPlus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:cardBackgroundColor="#24FFFFFF"
                app:cardCornerRadius="11dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/f" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/speedValueText"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/aigd"
                android:gravity="end"
                android:text="0.10x"
                android:textColor="@color/t"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. CONTROL PANEL - بالکل باٹم پر فکس -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="#1C000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/closeButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardBackgroundColor="#22FFFFFF"
                app:cardCornerRadius="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    app:tint="@color/f" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/playButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardBackgroundColor="@color/f"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/playIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    app:tint="@color/b" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dragHandle"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#22FFFFFF"
                app:cardCornerRadius="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_drag"
                    app:tint="@color/f" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resizeHandle"
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardBackgroundColor="#22FFFFFF"
                app:cardCornerRadius="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_resize"
                    app:tint="@color/f" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>