<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/b"
    tools:context=".TTSActivity">

    <!-- ============================================== -->
    <!-- HEADER SECTION                                -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/b"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button -->
            <LinearLayout
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_outline"
                android:backgroundTint="@color/f"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@null">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/b" />

            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aigd"
                android:text="Text to Voice"
                android:textColor="@color/f"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Save Button -->
            <LinearLayout
                android:id="@+id/saveButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_filled"
                android:backgroundTint="@color/f"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:stateListAnimator="@null">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/b" />

            </LinearLayout>

        </LinearLayout>

        <!-- Header Title -->
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/aigd"
            android:text="Text to Speech"
            android:textColor="@color/f"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Header Subtitle -->
        <TextView
            android:id="@+id/headerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:fontFamily="@font/aigd"
            android:text="Convert your script to voice"
            android:textColor="@color/f"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ============================================== -->
    <!-- SCROLLABLE CONTENT                           -->
    <!-- ============================================== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/b"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="120dp">

            <!-- ========================================== -->
            <!-- SCRIPT CONTENT DISPLAY                    -->
            <!-- ========================================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/b"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/f"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/aigd"
                        android:text="Script Content"
                        android:textColor="@color/f"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scriptContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/aigd"
                        android:lineSpacingExtra="6dp"
                        android:text="No script loaded"
                        android:textColor="@color/f"
                        android:textSize="16sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========================================== -->
            <!-- SCRIPT TITLE                              -->
            <!-- ========================================== -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Audio File Name"
                app:boxBackgroundColor="@color/b"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/f"
                app:boxStrokeWidth="1.5dp"
                app:hintTextColor="@color/f">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/audioTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/aigd"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:text="My Audio"
                    android:textColor="@color/f"
                    android:textColorHint="@color/f"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ========================================== -->
            <!-- VOICE SETTINGS CARD                       -->
            <!-- ========================================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/b"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/f"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/aigd"
                        android:text="Voice Settings"
                        android:textColor="@color/f"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Pitch Control -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/aigd"
                                android:text="Pitch"
                                android:textColor="@color/f"
                                android:textSize="13sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/pitchValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/aigd"
                                android:text="1.0"
                                android:textColor="@color/f"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/pitchSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="200"
                            android:progress="100"
                            android:progressTint="@color/f"
                            android:thumbTint="@color/f" />

                    </LinearLayout>

                    <!-- Speed Control -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/aigd"
                                android:text="Speed"
                                android:textColor="@color/f"
                                android:textSize="13sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/speedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/aigd"
                                android:text="1.0x"
                                android:textColor="@color/f"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/speedSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="300"
                            android:progress="100"
                            android:progressTint="@color/f"
                            android:thumbTint="@color/f" />

                    </LinearLayout>

                    <!-- Language / Voice Selection -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/aigd"
                            android:text="Voice"
                            android:textColor="@color/f"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:id="@+id/voiceSelector"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_outline"
                            android:backgroundTint="@color/b"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:stateListAnimator="@null">

                            <TextView
                                android:id="@+id/voiceName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/aigd"
                                android:text="Default"
                                android:textColor="@color/f"
                                android:textSize="13sp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_dropdown"
                                app:tint="@color/f" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========================================== -->
            <!-- AUTO DETECTION STATUS                     -->
            <!-- ========================================== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/autoDetectCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/f"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ProgressBar
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/b" />

                    <TextView
                        android:id="@+id/autoDetectStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/aigd"
                        android:text="Auto-detecting language..."
                        android:textColor="@color/b"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========================================== -->
            <!-- PLAYBACK CONTROLS                         -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Play Button -->
                <LinearLayout
                    android:id="@+id/playButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_filled"
                    android:backgroundTint="@color/f"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:translationZ="4dp">

                    <ImageView
                        android:id="@+id/playIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_play"
                        app:tint="@color/b" />

                </LinearLayout>

                <!-- Stop Button -->
                <LinearLayout
                    android:id="@+id/stopButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_outline"
                    android:backgroundTint="@color/b"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:translationZ="2dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_pause"
                        app:tint="@color/f" />

                </LinearLayout>

            </LinearLayout>

            <!-- ========================================== -->
            <!-- PROGRESS INDICATOR                        -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/progressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/audioProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:progressTint="@color/f" />

                <TextView
                    android:id="@+id/progressTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/aigd"
                    android:text="0:00"
                    android:textColor="@color/f"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ========================================== -->
            <!-- SAVE STATUS INDICATOR                     -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/saveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check"
                    app:tint="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/aigd"
                    android:text="Audio saved successfully!"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ========================================== -->
            <!-- FILE LOCATION                             -->
            <!-- ========================================== -->
            <TextView
                android:id="@+id/fileLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:alpha="0.4"
                android:fontFamily="@font/aigd"
                android:text=""
                android:textColor="@color/f"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- ============================================== -->
    <!-- LOADING OVERLAY                               -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/f" />

    </FrameLayout>

    <!-- ============================================== -->
    <!-- START.IO BANNER AD - BOTTOM                   -->
    <!-- ============================================== -->
    <com.startapp.sdk.ads.banner.Banner
        android:id="@+id/startAppBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>