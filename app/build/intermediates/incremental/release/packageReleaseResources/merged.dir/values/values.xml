<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="b">#FFFFFF</color>
    <color name="f">#009688</color>
    <string name="app_name">Reader</string>
    <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>

    </style>
    <style name="Theme.Reader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/f</item>
        <item name="colorPrimaryVariant">@color/f</item>
        <item name="colorOnPrimary">@color/b</item>

        <item name="colorSecondary">@color/f</item>
        <item name="colorSecondaryVariant">@color/f</item>
        <item name="colorOnSecondary">@color/b</item>

        <item name="android:statusBarColor">@color/f</item>
        <item name="android:windowBackground">@color/b</item>
    </style>
</resources>