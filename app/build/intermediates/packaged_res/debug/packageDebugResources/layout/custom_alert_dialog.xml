<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_filled"
    android:backgroundTint="@color/b"
    android:elevation="24dp"
    android:orientation="vertical"
    android:padding="28dp"
    android:translationZ="8dp">

    <!-- Dialog Header Icon & Title Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Decorative Icon -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_filled"
            android:backgroundTint="@color/f" />

        <!-- Dialog Header Notification Heading -->
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/aigd"
            android:letterSpacing="0.02"
            android:text="Alert"
            android:textColor="@color/f"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Decorative Accent Line -->
    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:alpha="0.6"
        android:background="@color/f" />

    <!-- Dialog Informational Context Message Body -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:alpha="0.75"
        android:fontFamily="@font/aigd"
        android:lineSpacingExtra="6dp"
        android:text="Are you sure you want to perform this action?"
        android:textColor="@color/f"
        android:textSize="15sp" />

    <!-- Horizontal Action Panel Segment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Negative Secondary Action Button (Dismiss / Close) -->
        <TextView
            android:id="@+id/negativeButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:alpha="0.7"
            android:background="@drawable/bg_outline"
            android:backgroundTint="@color/f"
            android:elevation="2dp"
            android:fontFamily="@font/aigd"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:stateListAnimator="@null"
            android:text="Cancel"
            android:textColor="@color/b"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Positive Primary Action Button (Execution / Discard) -->
        <TextView
            android:id="@+id/positiveButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_filled"
            android:backgroundTint="@color/f"
            android:elevation="4dp"
            android:fontFamily="@font/aigd"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:stateListAnimator="@null"
            android:text="Delete"
            android:textColor="@color/b"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Tiny Bottom Accent Glow (Premium Touch) -->
    <View
        android:layout_width="80dp"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:alpha="0.15"
        android:background="@color/f" />

</LinearLayout>